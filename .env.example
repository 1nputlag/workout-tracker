# Скопіюйте у файл .env (він ігнорується Git) і задайте власні значення
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workout
# Довгий випадковий рядок для підпису токенів JWT, наприклад: openssl rand -hex 32
JWT_SECRET=

# Порт бази на вашому комп'ютері (у контейнері — завжди 5432). Якщо 5433 теж зайнятий, змініть тут і в DATABASE_URL нижче
DB_PORT=5433

# Лише для розробки без контейнера сервера (npm run dev у server/), база — з `docker compose up -d db`.
# Логін і пароль мають збігатися з POSTGRES_USER і POSTGRES_PASSWORD вище.
DATABASE_URL=postgresql://app:change-me@localhost:5433/workout
# Окрема база для інтеграційних тестів на PostgreSQL. Її дані ОЧИЩАЮТЬСЯ перед кожним запуском тестів!
# TEST_DATABASE_URL=postgresql://app:change-me@localhost:5433/workout_test
